root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off

[*.{c,h}]
indent_style = space
indent_size = 4

[*.zig]
indent_style = space
indent_size = 4

[*.{bas,bas.expected}]
indent_style = space
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2
