' contrat 02 : fonctions de chaine - sans module
s = "  Bonjour le Monde  "
print "mid     : ", mid(s, 3, 5), "\n"
print "left    : [", left(s, 2), "]\n"
print "right   : [", right(s, 2), "]\n"
print "ucase   : ", ucase("abc"), "\n"
print "ucase$  : ", ucase$("abc"), "\n"
print "lcase   : ", lcase("ABC"), "\n"
print "trim    : [", trim(s), "]\n"
print "ltrim   : [", ltrim(s), "]\n"
print "rtrim   : [", rtrim(s), "]\n"
print "reverse : ", strreverse("abc"), "\n"
print "instr   : ", instr("Bonjour", "jou"), "\n"
print "string$ : ", string$(3, "ab"), "\n"
print "space   : [", space(3), "]\n"
print "chr     : ", chr(65), chr(66), "\n"
print "hex     : ", hex(255), "\n"
print "oct     : ", oct(8), "\n"
print "fin 02\n"
