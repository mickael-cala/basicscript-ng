' contrat 05 : math exacte - sans hasard, sans borne d'ABI
print "add     : ", 1234567 + 7654321, "\n"
print "mul     : ", 12345 * 67, "\n"
print "div-int : ", 1000 \ 7, "\n"
print "sqrt    : ", sqrt(4), "\n"
print "puiss   : ", 2 ^ 10, "\n"
print "abs     : ", abs(-5), "\n"
print "sgn     : ", sgn(-3), " ", sgn(0), " ", sgn(9), "\n"
print "max     : ", max(3, 9), "\n"
print "min     : ", min(3, 9), "\n"
print "gcd     : ", gcd(12, 18), "\n"
print "lcm     : ", lcm(4, 6), "\n"
print "odd     : ", odd(7), " ", odd(8), "\n"
print "even    : ", even(7), " ", even(8), "\n"
print "bin     : ", bin(10), "\n"
print "fin 05\n"
